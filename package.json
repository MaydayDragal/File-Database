{
  "name": "file-vault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, offline PWA file database for documents, videos, photos, PDFs and text. Runs entirely in the browser \u2014 no install or admin rights required.",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "icons": "python3 tools/gen_icons.py",
    "test": "node tools/test-static.mjs && node tools/test-backup-format.mjs && node tools/test-blob-integrity.mjs && node tools/run-e2e.mjs",
    "test:vault": "node tools/e2e.mjs",
    "test:merge": "node tools/e2e-merge.mjs",
    "test:inventory": "node tools/e2e-inventory.mjs",
    "test:shell": "node tools/e2e-shell.mjs",
    "test:sync": "node tools/e2e-sync.mjs",
    "test:pdfthumb": "node tools/e2e-pdfthumb.mjs",
    "test:vin": "node tools/e2e-vin.mjs",
    "test:vin-parallel": "node tools/e2e-vin-parallel.mjs",
    "test:vin-skip-video": "node tools/e2e-vin-skip-video.mjs",
    "test:vin-recall": "node tools/e2e-vin-recall.mjs",
    "test:vin-datacard": "node tools/e2e-vin-datacard.mjs",
    "test:vin-wmi": "node tools/e2e-vin-wmi.mjs",
    "test:debug": "node tools/e2e-debug.mjs",
    "build:portable": "node tools/build-portable.mjs",
    "test:portable": "node tools/e2e-portable.mjs",
    "test:static": "node tools/test-static.mjs",
    "test:backup": "node tools/test-backup-format.mjs",
    "test:integrity": "node tools/test-blob-integrity.mjs",
    "test:e2e": "node tools/run-e2e.mjs",
    "vendor:pdfjs": "node tools/vendor-pdfjs.mjs",
    "test:pdf-security": "node tools/e2e-pdf-security.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaydayDragal/File-Database.git"
  },
  "keywords": [
    "pwa",
    "offline",
    "indexeddb",
    "file-manager",
    "no-admin",
    "database"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MaydayDragal/File-Database/issues"
  },
  "homepage": "https://github.com/MaydayDragal/File-Database#readme",
  "devDependencies": {
    "esbuild": "0.25.5",
    "pdfjs-dist": "4.2.67",
    "playwright": "1.56.1"
  }
}
