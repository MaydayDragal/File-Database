{
  "name": "file-database-desktop",
  "productName": "File Database",
  "version": "1.0.0",
  "description": "File Database — portable desktop app (Files, LI Docs, Tool Inventory, Toolbox).",
  "author": "MaydayDragal",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win dir",
    "dist:win:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.maydaydragal.filedatabase",
    "productName": "File Database",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app/**/*",
      "icon.ico",
      "icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "FileDatabase-Portable-App.${ext}"
    }
  },
  "dependencies": {
    "resedit": "^2.0.3"
  }
}
